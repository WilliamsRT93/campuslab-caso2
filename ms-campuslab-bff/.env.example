# Emisor del User Pool de Cognito (region + pool id)
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# App client publico de Cognito que usa el frontend (Authorization Code + PKCE)
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Origen permitido por CORS (frontend)
FRONTEND_ORIGIN=http://localhost:5173
# URLs internas de los microservicios de dominio
CATALOG_URL=http://localhost:8081
BOOKINGS_URL=http://localhost:8082
