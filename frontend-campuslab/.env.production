# Sobrescribe solo los redirect URI de .env cuando se compila para produccion (npm run build,
# Vite carga .env.production automaticamente en modo build). El resto de las variables
# (client IDs, dominio Cognito, API Gateway, Kafka-UI) son las mismas en ambos entornos.
VITE_AZURE_REDIRECT_URI=https://100.60.125.97
VITE_COGNITO_REDIRECT_URI=https://100.60.125.97/cognito-callback
