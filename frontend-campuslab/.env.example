# --- Microsoft Entra ID (MSAL) : login del usuario (autenticador de Microsoft) ---
VITE_AZURE_CLIENT_ID=<entra-application-client-id>
VITE_AZURE_TENANT_ID=<entra-tenant-id>
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# --- Amazon Cognito (Hosted UI, App Client publico con PKCE) : token para la API ---
VITE_COGNITO_DOMAIN=https://<dominio>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<cognito-public-app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/cognito-callback
# Nombre del proveedor de identidad federado (Entra) configurado en Cognito.
# Con este valor el boton salta directo al login de Microsoft.
VITE_COGNITO_IDP=EntraID

# --- API Gateway (HTTP API) que enruta al BFF ---
VITE_API_BASE_URL=http://localhost:8080
