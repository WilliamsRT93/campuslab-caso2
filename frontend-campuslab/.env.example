# Variables del frontend (Vite). Copiar a .env:  cp .env.example .env
# Valores del entorno de demostracion en AWS. Son identificadores publicos de una SPA con
# PKCE (no hay secretos): sirven tal cual para correr el frontend local contra el entorno demo.

# --- Microsoft Entra ID (MSAL): login con cuenta de Microsoft ---
VITE_AZURE_CLIENT_ID=7c3d6c13-d08e-4a6f-a3dd-59ae9a171ac8
VITE_AZURE_TENANT_ID=d84b2661-a954-4b42-a9af-6b9c4990fb96
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# --- Amazon Cognito (Hosted UI, App Client publico con PKCE): token JWT para la API ---
VITE_COGNITO_DOMAIN=https://campuslab-wrivast.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=6r3af8ucc96okla0ujph9pru4a
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/cognito-callback
# Proveedor federado (Entra) para el boton "Iniciar sesion con Microsoft".
VITE_COGNITO_IDP=EntraID

# --- API Gateway (rutas definidas en infra/cloudformation/api-gateway-rutas.yaml) ---
VITE_API_BASE_URL=https://obxz43kip7.execute-api.us-east-1.amazonaws.com
